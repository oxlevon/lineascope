# ============================================
# LineaScope — project .gitignore
# ============================================

# Virtual environments
lineascope-env/
venv/
env/
.venv/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# Data (large — regenerable from pipeline except reference)
data/raw/
data/derived/
data/osm/
*.tif
*.tiff
*.gpkg
*.parquet

# Keep small reference data
!data/reference/*.geojson

# Models (regenerable)
models/*.joblib
models/*.pkl

# Results (regenerable)
results/*.png

# QGIS
*.qgz~
*.qmd~
.QGIS3/

# Node / frontend
node_modules/
web/node_modules/
web/dist/
web/.vite/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment files
.env
.env.local
*.env.local

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
desktop.ini

# Large helper rasters (regenerable)
data/derived/helper_*.tif
data/derived/helper_*.tif.aux.xml
data/derived/stack_20m.tif.aux.xml

# Temp
*.tmp
*.bak
~$*